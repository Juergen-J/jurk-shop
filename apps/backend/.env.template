SMTP_PASS=
EMAIL_FROM="JURK.PRO Shop <info@jurk.pro>"
# Public storefront URL used for links in emails
STOREFRONT_URL=http://localhost:8000

# Cloudflare R2 (S3 compatible) for product images. Leave empty locally to use ./static.
S3_FILE_URL=https://<public-bucket-domain>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
